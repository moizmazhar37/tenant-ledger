# Copy to .env.local for `npm run dev`. Values match docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenant_ledger

# Optional. A direct (non-pooled) connection for migrations when DATABASE_URL points at a
# pooler. Vercel's Neon integration sets this automatically.
# DATABASE_URL_UNPOOLED=

# Shared secret used to verify webhook signatures from the payment provider.
WEBHOOK_SECRET=whsec_local_development_only
